---
import AboutMeSections from "~/features/home/ui/AboutMeSections.astro"
import EducationSections from "~/features/home/ui/EducationSections.astro"
import ExperienceSections from "~/features/home/ui/ExperienceSections.astro"
import HeroSections from "~/features/home/ui/HeroSections.astro"
import type { Project } from "~/features/proyect/model/types"
import ProjectSection from "~/features/proyect/ui/project-section"
import Layout from "~/layouts/Layout.astro"
import { getPageData } from "~/shared/utils/getBlogPage"

const data = await getPageData(Astro.url, "projects")
---

<Layout>
  <HeroSections />
  <ExperienceSections />
  <ProjectSection
    title={data.title}
    subtitle={data.subtitle}
    viewProject={data.viewProject}
    projects={data.projects as Project[]}
    client:load
  />
  <EducationSections />
  <AboutMeSections />
</Layout>
